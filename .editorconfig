# EditorConfig for Jay's Mobile Wash
# Maintains consistent coding styles across editors
# https://editorconfig.org

root = true

# All files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# JavaScript, TypeScript, JSX, TSX
[*.{js,jsx,ts,tsx}]
indent_size = 2
max_line_length = 100

# JSON files
[*.json]
indent_size = 2

# HTML files
[*.html]
indent_size = 2
max_line_length = 120

# CSS, SCSS files
[*.{css,scss}]
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false
max_line_length = 80

# YAML files
[*.{yml,yaml}]
indent_size = 2

# Shell scripts
[*.sh]
end_of_line = lf

# Windows scripts
[*.{bat,cmd,ps1}]
end_of_line = crlf

# Makefile
[Makefile]
indent_style = tab

# Package files
[package.json]
indent_size = 2

# Configuration files
[{.eslintrc,.prettierrc,vercel.json,tsconfig.json}]
indent_size = 2
